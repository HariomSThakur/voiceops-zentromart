# Chat completions endpoint (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# OpenAI-compatible embeddings endpoint. It defaults to the LLM key/base URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Gnani speech API (required for batch voice mode)
GNANI_API_KEY=
STT_LANGUAGE=en-IN
TTS_LANGUAGE=en-IN
TTS_VOICE=Kaveri
TTS_MODEL=timbre-v2.5

# Project settings. Keep the dataset date fixed to the brief.
AS_OF_DATE=2026-10-20
DATASET_DIR=data/dataset/Capstone_Project_Dataset_FTTT_2026
INDEX_PATH=.cache/voiceops_index.sqlite3
OUTPUT_DIR=sample_outputs
RETRIEVAL_TOP_K=6
CHUNK_CHARS=1100
CHUNK_OVERLAP=140
